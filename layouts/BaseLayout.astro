---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/layout.css";

const { title = "TCG Website" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={`${base}img/tcg_icon.webp`} />
    <title>{title}</title>
    <script defer src={`${base}js/theme-toggle.js`}></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
    <Header />
    <main id="main-content" class="page-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
