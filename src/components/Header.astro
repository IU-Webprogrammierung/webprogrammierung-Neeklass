---
const navigation = [
  { href: "/", label: "Startseite" },
  { href: "/ygo/", label: "Yu-Gi-Oh!" },
  { href: "/lor/", label: "Legends of Runeterra" },
  { href: "/mtg/", label: "Magic: The Gathering" },
  { href: "/legal/", label: "Impressum" }
];

const currentPath = Astro.url.pathname;
const decklistNavigation = {
  "/ygo-decklist/": "/ygo/",
  "/lor-decklist/": "/lor/",
  "/mtg-decklist/": "/mtg/"
};
const activePath = decklistNavigation[currentPath] ?? currentPath;
---

<header class="site-header">
  <a class="site-logo" href="/" aria-label="Zur Startseite">
    TCG
  </a>
  <nav class="site-nav" aria-label="Hauptnavigation">
    <ul>
      {navigation.map((item) => (
        <li>
          <a href={item.href} aria-current={item.href === activePath ? "page" : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
