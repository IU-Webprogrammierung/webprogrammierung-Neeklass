---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const navigation = [
  { href: base, label: "Startseite" },
  { href: `${base}ygo/`, label: "Yu-Gi-Oh!" },
  { href: `${base}lor/`, label: "Legends of Runeterra" },
  { href: `${base}mtg/`, label: "Magic: The Gathering" },
  { href: `${base}legal/`, label: "Impressum" },
];

const currentPath = Astro.url.pathname;
const decklistNavigation = {
  [`${base}ygo-decklist/`]: `${base}ygo/`,
  [`${base}lor-decklist/`]: `${base}lor/`,
  [`${base}mtg-decklist/`]: `${base}mtg/`,
};
const activePath =
  decklistNavigation[currentPath as keyof typeof decklistNavigation] ??
  currentPath;
---

<header class="site-header">
  <a class="site-logo" href={base} aria-label="Zur Startseite">
    <img src={`${base}img/tcg_icon.webp`} width="512" height="512" alt="TCG Icon" />
  </a>
  <nav class="site-nav" aria-label="Hauptnavigation">
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.href === activePath ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
